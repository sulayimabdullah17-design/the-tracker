# ============================================
# نموذج متغيرات البيئة — للتوثيق
# انسخ هذا الملف إلى .env.local وعدّل القيم
# ============================================

# اسم التطبيق (يظهر في الواجهة والسجلات)
VITE_APP_NAME=THE TRACKER

# إصدار التطبيق
VITE_APP_VERSION=4.0.0

# مستوى السجلات: debug | info | warn | error
VITE_LOG_LEVEL=info

# تفعيل أدوات التطوير (React DevTools, إلخ)
VITE_ENABLE_DEVTOOLS=false

# تفعيل التحليلات (Analytics)
VITE_ENABLE_ANALYTICS=false

# مفتاح التخزين المحلي (localStorage)
VITE_STORAGE_KEY=the-tracker-v4